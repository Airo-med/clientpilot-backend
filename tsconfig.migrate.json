{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "node-pg-migrate": ["node_modules/node-pg-migrate/dist/bundle/index.d.ts"]
    },
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "migrations",
    "outDir": "dist/migrations",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "skipLibCheck": true
  },
  "include": ["migrations/**/*.ts"]
}
